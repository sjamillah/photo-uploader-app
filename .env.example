# Copy to .env for local development, then load it:
#
#   set -a; . ./.env; set +a
#
# .env is gitignored. In AWS none of this is set by hand: ECS injects the DB_*
# values from Secrets Manager and the rest from the task definition.

S3_BUCKET=
CLOUDFRONT_DOMAIN=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=photos
DB_USER=postgres
DB_PASSWORD=

# Optional. Defaults live in darkroom/config.py; uncomment only to override.
# PORT=8080
# FLASK_SECRET=
# MAX_UPLOAD_BYTES=12582912
# MAX_DESCRIPTION=280
# PAGE_SIZE=24
# DISPLAY_MAX=2048
# THUMB_MAX=480
# DISPLAY_QUALITY=82
# THUMB_QUALITY=72
# MAX_IMAGE_PIXELS=30000000
# POOL_MIN=1
# POOL_MAX=4
# DB_CONNECT_TIMEOUT=5
